# Required: xAI key (console.x.ai)
XAI_API_KEY=xai-your-key-here
# Any Grok model with vision + tool calling (list yours: GET https://api.x.ai/v1/language-models)
XAI_MODEL=grok-4.20-0309-non-reasoning
PORT=3000

# GitHub: used to create repos/PRs. Optional if the GitHub CLI is logged in (`gh auth login`).
GITHUB_TOKEN=

# Optional: Cursor Background Agents builds the MVP. Without it (or without repo access) Grok builds it.
CURSOR_API_KEY=

# Token Grok Bot (or any MCP client) must send as `x-api-key` to /mcp. Generate one: openssl rand -hex 16
MCP_TOKEN=
